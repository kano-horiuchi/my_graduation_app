<div class="container mt-4">
  <h2>管理者ダッシュボード</h2>
  <hr>
  <div class="row">
    <div class="col-md-6">
      <div class="card bg-light mb-3">
        <div class="card-body">
          <h5 class="card-title">総ユーザー数</h5>
          <p class="card-text fs-2"><%= @users_count %> 名</p>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card bg-light mb-3">
        <div class="card-body">
          <h5 class="card-title">総投稿数</h5>
          <p class="card-text fs-2"><%= @boards_count %> 件</p>
        </div>
      </div>
    </div>
  </div>
</div>
<header class="bg-white border-bottom sticky-top">
  <nav class="container-fluid d-flex align-items-center justify-content-between py-2">
    <%= link_to root_path, class: 'navbar-brand' do %>
      <%= image_tag 'log.png', height: '80' %>
    <% end %>
    <ul class="nav align-items-center">
      <li class="nav-item">
        <%= link_to t('defaults.header.boards'), boards_path, class: 'nav-link text-dark text-decoration-none' %>
      </li>
      <li class="nav-item">
        <%= link_to t('defaults.header.search'), search_boards_path, class: 'nav-link text-dark text-decoration-none' %>
      </li>
      <li class="nav-item">
        <%= link_to t('defaults.header.mypage'), mypage_path, class: 'nav-link text-dark text-decoration-none' %>
      </li>
      <li class="nav-item">
        <%= button_to t('defaults.header.logout'), logout_path, method: :delete, data: { turbo: false }, class: "nav-link btn btn-link text-dark text-decoration-none border-0 pb-2" %>
      </li>
    </ul>
  </nav>
</header>
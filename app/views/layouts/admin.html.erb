<!DOCTYPE html>
<html>
  <head>
    <title>管理者画面 - 日本酒Search</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="bg-light">

    <nav class="navbar navbar-expand navbar-dark bg-dark shadow-sm">
      <div class="container">
        
        <span class="navbar-brand fw-bold mb-0 h1 me-4">日本酒Search</span>

        <ul class="navbar-nav me-auto mb-0 d-flex align-items-center">
          <li class="nav-item me-3">
            <%= link_to 'ダッシュボード', admin_root_path, class: 'nav-link' %>
          </li>
          <li class="nav-item">
            <%= link_to 'ユーザー管理', admin_users_path, class: 'nav-link' %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to '投稿管理', admin_boards_path, class: 'nav-link' %>
          </li>
        </ul>
      
        <span class="navbar-text ms-auto">
          <%= link_to '一般サイトへ戻る', root_path, class: 'text-white-50 text-decoration-none small' %>
        </span>
      </div>
    </nav>

    <div class="container mt-3">
      <% flash.each do |message_type, message| %>
        <div class="alert alert-<%= message_type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <main>
      <%= yield %>
    </main>

  </body>
</html>
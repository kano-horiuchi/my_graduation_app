<!DOCTYPE html>
<html>
  <head>
    <title><%= t('defaults.app_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <% if logged_in? %>
      <%= render 'static_pages/header' %>
    <% else %>
      <%= render 'static_pages/before_login_header' %>
    <% end %>
    <% flash.each do |message_type, message| %>
      <% alert_class = case message_type.to_s when 'success', 'notice' then 'success' else 'danger' end %>
      <div class="alert alert-<%= alert_class %> alert-dismissible fade show" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
    <%= yield %>
    <%= render 'static_pages/footer' %>
  </body>
</html>

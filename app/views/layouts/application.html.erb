<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title).presence || t('defaults.app_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:site_name" content="<%= t('defaults.app_name') %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= yield(:title).presence || t('defaults.app_name') %>">
    <meta property="og:description" content="あなたの好みに合った日本酒を探しませんか？">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= asset_url('ogp_image.png') %>">
    <meta name="twitter:card" content="summary_large_image">

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <% if logged_in? %>
      <%= render 'static_pages/header' %>
    <% else %>
      <%= render 'static_pages/before_login_header' %>
    <% end %>
    <% flash.each do |message_type, message| %>
      <% alert_class = case message_type.to_s when 'success', 'notice' then 'success' else 'danger' end %>
      <div class="alert alert-<%= alert_class %> alert-dismissible fade show" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
    <main class="container-fluid">
      <div class="row">
        <div class="col-12">
          <%= yield %>
        </div>
      </div>
    </main>
    <%= render 'static_pages/footer' %>
  </body>
</html>

<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h2 class="card-title mb-4 border-bottom pb-2">
            <%= @board.title %>
          </h2>

          <div class="text-end text-muted small mb-3">
            <%= l @board.created_at, format: :long %>
          </div>

          <div class="mb-4">
            <h5 class="text-muted small"><%= Board.human_attribute_name(:tag_ids) %></h5>
            <div class="d-flex flex-wrap gap-2">
              <% @board.tags.each do |tag| %>
                <span class="badge rounded-pill bg-secondary"><%= tag.name %></span>
              <% end %>
            </div>
          </div>

          <div class="mb-4">
            <h5 class="text-muted small"><%= Board.human_attribute_name(:body) %></h5>
            <div class="p-3 bg-light rounded" style="white-space: pre-wrap;">
              <%= @board.body.presence || "(メモはありません)" %>
            </div>
          </div>

          <div class="d-flex justify-content-end mt-5">
            <% if current_user.own?(@board) %>
              <%= link_to t('defaults.update.submit'), edit_board_path(@board), class: "btn btn-success me-2" %>
              <%= button_to t('defaults.destroy'), board_path(@board), method: :delete, data: { turbo: false }, class: "btn btn-danger", onclick: "return confirm('#{t('defaults.message.delete_confirm')}');" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

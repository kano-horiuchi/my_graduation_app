<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
            <h2 class="card-title mb-0">
              <%= @board.title %>
            </h2>
            <div class="flex-shrink-0 ps-3">
              <%= render 'favorites/favorite_button', board: @board %>
            </div>
          </div>

          <div class="text-end text-muted small mb-3">
            <%= l @board.created_at, format: :long %>
          </div>

          <div class="mb-4">
            <h5 class="text-muted small"><%= Board.human_attribute_name(:tag_ids) %></h5>
            <div class="d-flex flex-wrap gap-2">
              <% @board.tags.each do |tag| %>
                <span class="badge rounded-pill bg-secondary"><%= tag.name %></span>
              <% end %>
            </div>
          </div>

          <% if @board.board_images.present? %>
            <div class="image-gallery mb-4" data-controller="gallery">
              <div class="main-image mb-2 text-center">
                <%= image_tag @board.board_images[0].url, class: "img-fluid rounded shadow-sm", style: "max-height: 400px; width: 100%; object-fit: contain; background-color: #f8f9fa;", data: { gallery_target: "main" } %>
              </div>

              <% if @board.board_images.size > 1 %>
                <div class="row g-2 justify-content-center">
                  <% @board.board_images.each do |image| %>
                    <div class="col-3 col-sm-2">
                      <div class="ratio ratio-1x1 border rounded overflow-hidden shadow-xs">
                        <%= image_tag image.url, class: "img-fluid object-fit-cover", style: "cursor: pointer;", data: { action: "click->gallery#changeImage" } %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% elsif @board.board_image? %>
            <%= image_tag @board.board_image_url, class: "img-fluid mb-3 rounded" %>
          <% else %>
            <div class="bg-light p-5 text-center mb-3 text-muted">No Image</div>
          <% end %>

          <div class="mb-4">
            <h5 class="text-muted small"><%= Board.human_attribute_name(:body) %></h5>
            <div class="p-3 bg-light rounded" style="white-space: pre-wrap;"><%= @board.body.presence&.strip || "(メモはありません)" %></div>
          </div>

          <div class="d-flex justify-content-end mt-5 align-items-center" data-controller="loading">
            <% if current_user.own?(@board) %>
              <%= link_to t('defaults.update.submit'), edit_board_path(@board), class: "btn btn-edit me-2" %>
              <%= button_to t('defaults.destroy'), board_path(@board), method: :delete, data: { turbo: false, action: "click->loading#show" }, class: "btn btn-delete", onclick: "return confirm('#{t('defaults.message.delete_confirm')}');" %>
              <div class="text-danger ms-2 d-none" data-loading-target="message">
                <strong>削除中...</strong>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="recommend-section mt-5">
        <h4 class="fw-bold text-center mb-4"><%= t('boards.show.recommend') %></h4>
        <div class="row row-cols-1 row-cols-md-3 g-3">
          <% @recommended_boards.each do |board| %>
            <div class="col">
              <div class="card h-100 shadow-sm border-0 bg-white">
                <div class="ratio ratio-4x3 bg-light rounded-top overflow-hidden">
                  <% if board.board_images.present? %>
                    <%= image_tag board.board_images[0].url, class: "img-fluid object-fit-cover" %>
                  <% elsif board.board_image? %>
                    <%= image_tag board.board_image_url, class: "img-fluid object-fit-cover" %>
                  <% else %>
                    <div class="d-flex align-items-center justify-content-center text-muted small">No Image</div>
                  <% end %>
                </div>

                <div class="card-body d-flex flex-column p-3">
                  <h6 class="card-title fw-bold text-dark mb-2 text-truncate">
                    <%= board.title %>
                  </h6>

                  <div class="mb-3 flex-wrap gap-1 d-flex">
                    <% board.tags.take(2).each do |tag| %>
                      <span class="badge rounded-pill bg-secondary small" style="font-size: 0.75rem;">
                        <%= tag.name %>
                      </span>
                    <% end %>
                  </div>

                  <%= link_to t('boards.board.show_detail'), board_path(board), class: 'btn btn-outline-primary btn-sm w-100 mt-auto' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container pt-3">
  <h1 class="text-center my-4"><%= t('boards.index.title') %></h1>

  <% if params[:q].present? %>
    <div class="text-center mb-4">
      <p class="text-secondary mb-2"><%= t('defaults.search_results.display', count: @boards.count) %></p>
      <%= link_to search_boards_path, class: "btn btn-sm btn-light rounded-pill border px-3 text-muted" do %>
        <%= t('defaults.serach_clear') %>
      <% end %>
    </div>
  <% end %>

  <div class="d-flex flex-column align-items-center justify-content-center my-5 gap-3">
    <%= link_to new_board_path, class: "btn btn-lg rounded-pill px-5 shadow-sm text-white", style: "min-width: 240px; max-width: 300px; background-color: #a8a090; border-color: #a8a090;" do %>
      <i class="bi bi-pencil-fill me-2"></i><%= t('.new_board') %>
    <% end %>

    <%= link_to favorites_boards_path, class: "btn rounded-pill px-2 shadow-sm", style: "min-width: 240px; max-width: 300px; background-color: #f9f7f2; border-color: #a8a090; color: #a8a090;" do %>
      <i class="bi bi-heart-fill me-2"></i><%= t('.favorite_boards') %>
    <% end %>
  </div>

  <div class="row">
    <% if @boards.present? %>
      <%= render @boards %>
    <% else %>
      <div class="text-center mb-3 text-muted py-5">
        <%= params[:q].present? ? t('defaults.search_results.zero') : t('boards.index.no_result') %>
      </div>
    <% end %>
  </div>
</div>

<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <h1 class="text-center my-4"><%= t('boards.index.title') %></h1>
      <div class="row">
        <% if @boards.present? %>
          <%= render @boards %>
        <% else %>
          <div class="text-center mb-3 text-muted">
            <%= t('boards.index.no_result') %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="col-sm-12 col-lg-4 mb-3">
  <div id="board-<%= board.id %>" class="card h-100 shadow-sm">
    <% if board.board_image? && board.board_image.url&.start_with?('http') %>
      <%= image_tag board.board_image.url, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
    <% else %>
      <%= image_tag 'board_placeholder.png', class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
    <% end %>

    <div class="card-body">
      <h5 class="card-title">
        <%= link_to board.title, board_path(board), class: "text-decoration-none text-dark" %>
      </h5>
      <p class="card-text text-muted">
        <%= truncate(board.body, length: 70) %>
      </p>
    </div>
  </div>
</div>
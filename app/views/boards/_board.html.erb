<div class="col-12 col-md-6 col-lg-4 mb-3">
  <div id="board-<%= board.id %>" class="card h-100 shadow-sm">
    <% if board.board_image? %>
      <%= image_tag board.board_image_url, class: "card-img-top img-fluid", style: "height: 200px; object-fit: cover;" %>
    <% else %>
      <%= image_tag 'top.jpg', class: "card-img-top img-fluid", style: "height: 200px; object-fit: cover;" %>
    <% end %>

    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="card-title mb-0">
          <%= link_to board.title, board_path(board), class: "text-decoration-none text-dark" %>
        </h5>
        
        <div class="flex-shrink-0 ps-3">
          <%= render 'favorites/favorite_button', board: board %>
        </div>
      </div>
      <p class="card-text text-muted">
        <%= truncate(board.body, length: 70) %>
      </p>
    </div>
  </div>
</div>
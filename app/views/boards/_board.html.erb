<div class="col-sm-12 col-lg-4 mb-3">
  <div id="board-id-<%= board.id %>">
    <div class="card h-100"> 
      <%= image_tag "board_placeholder.png", class: "card-img-top", width: "300", height:"200" %>
      <div class="card-body">
        <div class="d-flex align-items-center">
          <h4 class="card-title">
            <%= link_to board.title, board_path(board), class: "text-decoration-none" %>
          </h4>
          <div class='ms-auto'>
            <%= link_to edit_board_path(board), id: "button-edit-#{board.id}" do %>
              <i class="bi bi-pencil-fill text-dark"></i>
            <% end %>
            <%= link_to board_path(board), id: "button-delete-#{board.id}", 
                         data: { turbo_method: :delete, turbo_confirm: t('defaults.message.delete_confirm') } do %>
              <i class="bi bi-trash-fill text-dark"></i>
            <% end %>
          </div>
        </div>
        <ul class="list-inline mb-2 text-muted small">
          <li class="list-inline-item"><i class="bi bi-person me-1"></i><%= board.user.name %></li>
          <li class="list-inline-item"><i class="bi bi-calendar me-1"></i><%= l board.created_at, format: :long %></li>
        </ul>
        <p class="card-text text-truncate"><%= board.body %></p>
      </div>
    </div>
  </div>
</div>
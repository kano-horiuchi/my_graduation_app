<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1 class="text-center my-4"><%= t('boards.new.title') %></h1>

      <%= form_with model: @board, data: { turbo: false }, html: { multipart: true } do |f| %>
        <% if @board.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @board.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :title, class: "form-label" %>
          <span class="badge bg-danger ms-2">必須</span>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <label class="form-label d-block">
            <%= Board.human_attribute_name(:tag_ids) %>
            <span class="badge bg-danger ms-2">必須</span>
          </label>
          <div class="d-flex flex-wrap gap-2">
            <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |b| %>
              <%= b.check_box(class: "btn-check") %>
              <%= b.label(class: "btn btn-outline-secondary") %>
            <% end %>
          </div>
        </div>

        <div class="mb-3">
          <%= f.label :board_images, class: "form-label" %>
          <%= f.file_field :board_images, multiple: true, class: "form-control", accept: 'image/*' %>
        </div>

        <div class="mb-3">
          <%= f.label :body, class: "form-label" %>
          <span class="text-muted small">（任意）</span>
          <%= f.text_area :body, rows: 5, class: "form-control", placeholder: "味の感想や、一緒に食べた料理などを自由に書いてみましょう！" %>
        </div>
        <div class="text-center my-5">
          <%= f.submit t('boards.create.submit'), class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="text-center">
      <h1><%= t('boards.edit.title') %></h1>
      </div>

      <%= form_with model: @board, data: { turbo: false }, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :title, class: "form-label" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :tag_ids, class: "form-label" %>
          <%= f.collection_check_boxes :tag_ids, Tag.all, :id, :name do |b| %>
            <div class="form-check">
              <%= b.check_box class: "form-check-input" %>
              <%= b.label class: "form-check-label" %>
            </div>
          <% end %>
        </div>

        <div class="mb-3">
          <%= f.label :board_image, class: "form-label" %>
          <% if @board.board_image? %>
            <div class="mb-3">
              <p class="small text-muted mb-1"><%= t('boards.edit.image') %></p>
              <%= image_tag @board.board_image_url, class: "img-thumbnail", style: "max-width: 200px;" %>
            </div>
          <% end %>
          <%= f.file_field :board_image, class: "form-control", accept: 'image/*' %>
          <%= f.hidden_field :board_image_cache %>
          <div class="form-text"><%= t('boards.edit.message') %></div>
        </div>

        <div class="mb-3">
          <%= f.label :body, class: "form-label" %>
          <%= f.text_area :body, class: "form-control", rows: 5 %>
        </div>

        <div class="text-center">
        <%= f.submit t('defaults.submit'), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

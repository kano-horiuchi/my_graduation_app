<div class="container py-5">
  <div class="row">
    <div class="col-md-8 mx-auto">
      <div class="text-center">
      <h2 class="fs-4 fs-md-2 text-wrap"><%= t('boards.edit.title') %></h2>
      </div>

      <%= form_with model: @board, data: { turbo: false, controller: "loading" }, html: { multipart: true }, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :title, class: "form-label" %>
          <span class="badge bg-danger ms-2">必須</span>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="mb-3">
          <label class="form-label d-block">
            <%= Board.human_attribute_name(:tag_ids) %>
            <span class="badge bg-danger ms-2">必須</span>
          </label>
          <div class="d-flex flex-wrap gap-2">
            <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |b| %>
              <%= b.check_box(class: "btn-check") %>
              <%= b.label(class: "btn btn-outline-secondary") %>
            <% end %>
          </div>
        </div>

        <div class="mb-3" data-controller="image-compression">
          <%= f.label :board_images, class: "form-label" %>
          <% if @board.board_images.present? %>
            <div class="mb-3">
              <p class="small text-muted mb-1"><%= t('boards.edit.image') %></p>
              <div class="d-flex gap-2 flex-wrap">
                <% @board.board_images.each_with_index do |image, index| %>
                  <div class="text-center">
                    <%= image_tag image.url, class: "img-thumbnail d-block mb-1", style: "width: 100px; height: 100px; object-fit: cover;" %>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" name="board[delete_image_ids][]" value="<%= index %>" id="delete_image_<%= index %>">
                      <label class="form-check-label small text-danger" for="delete_image_<%= index %>">削除</label>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          <%= f.file_field :board_images, multiple: true, class: "form-control", accept: 'image/*', data: { image_compression_target: "input", action: "change->image-compression#compress" } %>
          <div class="form-text"><%= t('boards.edit.message') %></div>
        </div>

        <div class="mb-3">
          <%= f.label :body, class: "form-label" %>
          <%= f.text_area :body, class: "form-control", rows: 5 %>
        </div>

        <div class="text-center">
          <div class="d-flex justify-content-center align-items-center gap-3">
            <%= f.submit t('defaults.submit'), class: "btn btn-primary", data: { action: "click->loading#show"} %>
          <div class="text-primary d-none" data-loading-target="message">
            <strong>更新中...</strong>
        </div>
      <% end %>
    </div>
  </div>
</div>

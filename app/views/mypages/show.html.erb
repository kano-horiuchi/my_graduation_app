<div class="container pt-3">
  <div class="row">
    <div class="col-12">
      <h1 class="text-center my-4">
        <%= t('mypages.show.title') %>
      </h1>
      <div class="table-responsive mb-5">
        <table class="table table-bordered align-middle">
          <tbody>
            <tr>
              <th scope="row" class="bg-light w-25">
                <%= User.human_attribute_name(:name) %>
              </th>
              <td><%= current_user.name %></td>
            </tr>
            <tr>
              <th scope="row" class="bg-light">
                <%= User.human_attribute_name(:email) %>
              </th>
              <td><%= current_user.email %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="text-end mb-3">
        <%= link_to t('profiles.edit.title'), edit_profile_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
      <h2 class="text-center mt-5 mb-4 border-bottom pb-2">
        <%= t('mypages.show.sub_title') %>
      </h2>
      <div class="row">
        <% if @boards.present? %>
          <%= render @boards %>
        <% else %>
          <div class="text-center mb-3 text-muted">
          <%= t('mypages.show.no_result') %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

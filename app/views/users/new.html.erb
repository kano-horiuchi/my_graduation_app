<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1 class="my-4"><%= t('users.new.title') %></h1>
      
      <%= form_with model: @user, data:{ turbo: false } do |f| %>
        <div class="mb-3">
          <%= f.label :name, User.human_attribute_name(:name), class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, User.human_attribute_name(:email), class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, User.human_attribute_name(:password), class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, User.human_attribute_name(:password_confirmation), class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>

        <div class="d-grid gap-2 mb-5">
          <%= f.submit t('users.new.submit'), class: "btn btn-primary" %>
        </div>
      <% end %>

      <div class='text-center my-5'>
        <%= button_to auth_at_provider_path(provider: :google), method: :post, data: { turbo: false }, class: "btn btn-outline-dark" do %>
          <i class="bi bi-google"></i> Googleアカウントで登録
        <% end %>
      </div>

      <div class="text-center my-5">
        <%= link_to t('users.new.to_login_page'), login_path, class: "text-decoration-none" %>
      </div>
    </div>
  </div>
</div>

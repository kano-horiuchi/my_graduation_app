<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <div class='text-center my-5'>
        <h1><%= t('sessions.new.title') %></h1>
      </div>
      <%= form_with url: login_path, data: { turbo: false } do |f| %>
        <div class="mb-3">
          <%= f.label :email, User.human_attribute_name(:email), class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, User.human_attribute_name(:password), class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <div class='text-center my-5'>
          <%= f.submit t('sessions.new.submit'), class: "btn btn-primary" %>
        </div>
      <% end %>
      <div class='text-center my-5'>
        <%= button_to auth_at_provider_path(provider: :google), method: :post, data: { turbo: false }, class: "btn btn-outline-dark" do %>
          <i class="bi bi-google"></i> Googleでログイン
        <% end %>
      </div>
      <div class='text-center my-5'>
        <%= link_to "パスワードをお忘れの方はこちら", new_password_reset_path, class: "text-muted text-decoration-none" %>
      </div>
      <div class='text-center my-5'>
        <%= link_to t('sessions.new.to_register_page'), new_user_path %>
      </div>
    </div>
  </div>
</div>